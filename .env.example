# Скопіюйте у .env і змініть значення за потреби.
# Якщо .env відсутній, використовуються значення за замовчуванням з docker-compose.yml.

POSTGRES_USER=food
POSTGRES_PASSWORD=food_pass
POSTGRES_DB=food_delivery

RABBITMQ_USER=food
RABBITMQ_PASSWORD=food_pass

# секрет для підпису сесій і пароль адміністратора (створюється при першому запуску)
AUTH_SECRET=change-me-please
AUTH_ADMIN_PASSWORD=admin123

# середня кількість нових замовлень за хвилину
ORDERS_PER_MINUTE=40
